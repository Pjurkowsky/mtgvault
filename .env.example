# Copy to .env — used by docker-compose.dev.yml and docker-compose.prod.yml

# Django
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Needed in prod for admin login, e.g. https://mtgvault.example.com
CSRF_TRUSTED_ORIGINS=http://localhost
# Prod only: send the login cookie over HTTPS only. Set False to test prod on plain http.
AUTH_COOKIE_SECURE=True

# PostgreSQL
POSTGRES_DB=mtgvault
POSTGRES_USER=mtgvault
POSTGRES_PASSWORD=change-me
# Host port for Postgres in dev
POSTGRES_PORT=5432
# Host port for Redis in dev
REDIS_PORT=6379

# Host port for the site in prod
HTTP_PORT=80
