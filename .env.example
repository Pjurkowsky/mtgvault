# Copy to .env — used by docker-compose.dev.yml (self-hosting: .env.selfhost.example)

# Django
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost
# Send the login cookie over HTTPS only
AUTH_COOKIE_SECURE=False

# PostgreSQL
POSTGRES_DB=mtgvault
POSTGRES_USER=mtgvault
POSTGRES_PASSWORD=change-me
# Host port for Postgres in dev
POSTGRES_PORT=5432
# Host port for Redis in dev
REDIS_PORT=6379

