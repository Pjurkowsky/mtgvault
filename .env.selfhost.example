# MTG Vault self-hosting settings (spec 008). Copy to .env next to compose.yml.

# Required: the address people open, as your reverse proxy serves it.
# Phones can scan cards only over https.
MTGVAULT_URL=https://cards.example.com

# Required: the database password. Letters and digits only. Generate one with:
#   openssl rand -hex 24
DB_PASSWORD=

# Image tag: release (newest version), a version like 1.2 or 1.2.3, or edge (master).
MTGVAULT_VERSION=release

# Host port your reverse proxy connects to. Docker-published ports bypass ufw.
MTGVAULT_PORT=8080

# Folder for all data: app/ (scanner files, secrets, backups), postgres/, valkey/.
DATA_LOCATION=./data

# Optional
TZ=UTC
GUNICORN_WORKERS=2
# Nightly database dumps kept in DATA_LOCATION/app/backups
BACKUP_KEEP=14

# Pod simulation (spec 024): run the forge service with
#   docker compose --profile forge up -d
# and point MTG Vault at it. Each game uses about 1 GB of memory.
#FORGE_URL=http://forge:8790
# Cores the forge service may use (0: no limit), to keep some free for the rest.
#FORGE_CPUS=3
