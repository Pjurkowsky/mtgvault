#!/command/with-contenv bash
# Bundled Redis; stays idle when REDIS_URL points elsewhere (spec 008, AC-2).
if [ "$MTGVAULT_BUNDLED_REDIS" != 1 ]; then exec sleep infinity; fi
exec s6-setuidgid redis redis-server --bind 127.0.0.1 --port 6379 --dir /data/redis \
  --save 60 1 --daemonize no --logfile ""
